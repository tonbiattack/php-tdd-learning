{
  "name": "tonbiattack/php-tdd-learning",
  "description": "PHP 8.2+ をテスト駆動開発で学ぶための実行可能な教材",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "PhpTddLearning\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PhpTddLearning\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "testdox": "phpunit --configuration phpunit.xml --testdox",
    "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
    "analyse": "@lint"
  },
  "config": {
    "sort-packages": true
  }
}
